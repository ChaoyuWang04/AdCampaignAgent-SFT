[
  {
    "type": "function",
    "function": {
      "name": "search_trending_creatives",
      "description": "搜索指定平台和游戏品类的热门广告素材，返回高热度/高CTR的创意内容列表",
      "parameters": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "广告平台",
            "enum": ["tiktok", "meta", "google_uac"]
          },
          "game_genre": {
            "type": "string",
            "description": "游戏品类",
            "enum": ["puzzle", "casual", "hyper_casual", "rpg", "strategy"]
          },
          "region": {
            "type": "string",
            "description": "目标地区，如 'US'、'JP'、'SEA'"
          },
          "time_range": {
            "type": "integer",
            "description": "查询最近N天的数据，默认7天",
            "default": 7
          },
          "top_k": {
            "type": "integer",
            "description": "返回Top K条素材，默认10条",
            "default": 10
          }
        },
        "required": ["platform", "game_genre", "region"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_competitor_ads",
      "description": "搜索竞品在指定平台投放的广告素材，用于竞品分析和创意参考",
      "parameters": {
        "type": "object",
        "properties": {
          "competitor_name": {
            "type": "string",
            "description": "竞品公司或游戏名称，如 'Playrix'、'Rollic'"
          },
          "platform": {
            "type": "string",
            "description": "广告平台",
            "enum": ["tiktok", "meta", "google_uac"]
          },
          "limit": {
            "type": "integer",
            "description": "返回结果数量上限，默认20条",
            "default": 20
          }
        },
        "required": ["competitor_name", "platform"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_trending_hooks",
      "description": "获取当前高CTR广告的开场钩子文案或视频钩子模板，用于指导素材创作方向",
      "parameters": {
        "type": "object",
        "properties": {
          "game_genre": {
            "type": "string",
            "description": "游戏品类",
            "enum": ["puzzle", "casual", "hyper_casual", "rpg", "strategy"]
          },
          "creative_type": {
            "type": "string",
            "description": "素材类型",
            "enum": ["video", "playable", "image"]
          }
        },
        "required": ["game_genre", "creative_type"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "validate_creative_spec",
      "description": "上传前校验素材是否符合目标平台的技术规范，包括尺寸、时长、文件大小等",
      "parameters": {
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "description": "素材文件路径或URL"
          },
          "platform": {
            "type": "string",
            "description": "目标广告平台",
            "enum": ["tiktok", "meta", "google_uac"]
          },
          "ad_format": {
            "type": "string",
            "description": "广告格式",
            "enum": ["interstitial", "banner", "rewarded", "native"]
          }
        },
        "required": ["file_path", "platform", "ad_format"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "upload_creative_asset",
      "description": "将单个广告素材上传至指定Campaign和Ad Group，上传前建议先调用 validate_creative_spec",
      "parameters": {
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "description": "素材文件路径或URL"
          },
          "asset_type": {
            "type": "string",
            "description": "素材类型",
            "enum": ["video", "image", "html5"]
          },
          "campaign_id": {
            "type": "string",
            "description": "目标Campaign ID"
          },
          "ad_group_id": {
            "type": "string",
            "description": "目标Ad Group ID"
          },
          "creative_name": {
            "type": "string",
            "description": "素材命名，建议遵循团队命名规范"
          }
        },
        "required": ["file_path", "asset_type", "campaign_id", "ad_group_id", "creative_name"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "batch_upload_creatives",
      "description": "批量上传多个广告素材至指定Campaign，支持自定义命名规则",
      "parameters": {
        "type": "object",
        "properties": {
          "file_paths": {
            "type": "array",
            "items": { "type": "string" },
            "description": "素材文件路径列表"
          },
          "campaign_id": {
            "type": "string",
            "description": "目标Campaign ID"
          },
          "naming_convention": {
            "type": "string",
            "description": "命名规则模板，如 '{genre}_{region}_{date}_{index}'"
          }
        },
        "required": ["file_paths", "campaign_id"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_campaign_metrics",
      "description": "查询指定Campaign在特定时间段内的核心投放指标，支持按天、国家、Ad Group、素材等维度拆分",
      "parameters": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "Campaign ID"
          },
          "metrics": {
            "type": "array",
            "items": { "type": "string" },
            "description": "需要查询的指标列表，可选值：impressions、clicks、ctr、cpi、roas、retention_d1、retention_d7、spend"
          },
          "date_range": {
            "type": "object",
            "description": "查询时间范围",
            "properties": {
              "start": { "type": "string", "description": "开始日期，格式 YYYY-MM-DD" },
              "end": { "type": "string", "description": "结束日期，格式 YYYY-MM-DD" }
            },
            "required": ["start", "end"]
          },
          "breakdown": {
            "type": "string",
            "description": "数据拆分维度",
            "enum": ["daily", "country", "ad_group", "creative"],
            "default": "daily"
          }
        },
        "required": ["campaign_id", "metrics", "date_range"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_creative_performance",
      "description": "获取Campaign内各素材的效果排行，用于识别高潜力素材和疲劳素材",
      "parameters": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "Campaign ID"
          },
          "sort_by": {
            "type": "string",
            "description": "排序指标",
            "enum": ["ctr", "ipm", "cpi", "roas"],
            "default": "ctr"
          },
          "top_k": {
            "type": "integer",
            "description": "返回Top K条素材，默认10",
            "default": 10
          },
          "date_range": {
            "type": "object",
            "description": "查询时间范围",
            "properties": {
              "start": { "type": "string", "description": "开始日期，格式 YYYY-MM-DD" },
              "end": { "type": "string", "description": "结束日期，格式 YYYY-MM-DD" }
            },
            "required": ["start", "end"]
          }
        },
        "required": ["campaign_id", "date_range"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_appsflyer_report",
      "description": "从 AppsFlyer 拉取归因报告，支持安装量、留存率、收入、Cohort等报告类型",
      "parameters": {
        "type": "object",
        "properties": {
          "app_id": {
            "type": "string",
            "description": "AppsFlyer App ID"
          },
          "report_type": {
            "type": "string",
            "description": "报告类型",
            "enum": ["installs", "retention", "revenue", "cohort"]
          },
          "date_range": {
            "type": "object",
            "description": "查询时间范围",
            "properties": {
              "start": { "type": "string", "description": "开始日期，格式 YYYY-MM-DD" },
              "end": { "type": "string", "description": "结束日期，格式 YYYY-MM-DD" }
            },
            "required": ["start", "end"]
          },
          "groupby": {
            "type": "array",
            "items": { "type": "string" },
            "description": "聚合维度，可选值：media_source、campaign、country、ad_group"
          }
        },
        "required": ["app_id", "report_type", "date_range"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "compare_campaigns",
      "description": "横向对比多个Campaign的核心指标，用于预算分配决策和策略优选",
      "parameters": {
        "type": "object",
        "properties": {
          "campaign_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "需要对比的Campaign ID列表，至少2个"
          },
          "metrics": {
            "type": "array",
            "items": { "type": "string" },
            "description": "对比指标列表，可选值：ctr、cpi、roas、spend、installs"
          },
          "date_range": {
            "type": "object",
            "description": "查询时间范围",
            "properties": {
              "start": { "type": "string", "description": "开始日期，格式 YYYY-MM-DD" },
              "end": { "type": "string", "description": "结束日期，格式 YYYY-MM-DD" }
            },
            "required": ["start", "end"]
          }
        },
        "required": ["campaign_ids", "metrics", "date_range"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "detect_anomalies",
      "description": "对指定Campaign的某个指标进行异常检测，识别突发波动并返回可能原因",
      "parameters": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "Campaign ID"
          },
          "metric": {
            "type": "string",
            "description": "监控的指标",
            "enum": ["ctr", "cpi", "roas", "spend", "installs", "retention_d1"]
          },
          "sensitivity": {
            "type": "number",
            "description": "异常检测灵敏度，范围 0.0-1.0，值越高越容易触发告警，默认 0.7",
            "default": 0.7
          }
        },
        "required": ["campaign_id", "metric"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "query_knowledge_base",
      "description": "检索内部知识库，获取投放策略、素材规范、平台政策等专业知识，使用 RAG 返回相关文档片段",
      "parameters": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "查询问题，用自然语言描述"
          },
          "domain": {
            "type": "string",
            "description": "知识领域",
            "enum": ["bidding_strategy", "creative_guideline", "platform_policy", "industry_benchmark"]
          },
          "search_mode": {
            "type": "string",
            "description": "检索模式：vector(向量检索)、keyword(关键词检索)、hybrid(混合检索)",
            "enum": ["vector", "keyword", "hybrid"],
            "default": "hybrid"
          },
          "top_k": {
            "type": "integer",
            "description": "返回相关文档片段数量，默认5",
            "default": 5
          }
        },
        "required": ["question", "domain"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_benchmark_data",
      "description": "获取行业基准数据，用于判断当前Campaign指标是否处于正常水平",
      "parameters": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "description": "需要对标的指标",
            "enum": ["ctr", "cpi", "roas", "retention_d1", "retention_d7", "ipm"]
          },
          "game_genre": {
            "type": "string",
            "description": "游戏品类",
            "enum": ["puzzle", "casual", "hyper_casual", "rpg", "strategy"]
          },
          "region": {
            "type": "string",
            "description": "目标地区，如 'US'、'JP'、'SEA'"
          },
          "platform": {
            "type": "string",
            "description": "广告平台",
            "enum": ["tiktok", "meta", "google_uac"]
          }
        },
        "required": ["metric", "game_genre", "region", "platform"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_platform_policy",
      "description": "查询各广告平台的官方政策文档，包括广告格式要求、内容限制、定向规则等",
      "parameters": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "广告平台",
            "enum": ["tiktok", "meta", "google_uac"]
          },
          "policy_type": {
            "type": "string",
            "description": "政策类型",
            "enum": ["ad_format", "content_restriction", "targeting", "billing"]
          }
        },
        "required": ["platform", "policy_type"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_optimization_playbook",
      "description": "根据当前问题类型获取结构化的优化 SOP，返回可执行的分析步骤和操作建议",
      "parameters": {
        "type": "object",
        "properties": {
          "issue_type": {
            "type": "string",
            "description": "问题类型",
            "enum": ["high_cpi", "low_ctr", "budget_underdelivery", "creative_fatigue", "low_roas", "high_cpm"]
          }
        },
        "required": ["issue_type"]
      }
    }
  }
]